{
  "functions": {
    "api/ask.js": {
      "maxDuration": 60,
      "includeFiles": "api/_data.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
